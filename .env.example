# Mẫu biến môi trường — KHÔNG chứa giá trị thật, KHÔNG commit `.env`.
# Trên Railway đặt bằng `railway variables`; ở máy thì copy file này thành `.env`.

# ── Cốt lõi ───────────────────────────────────────────────────────────────────
DATABASE_URL=postgres://user:pass@host:5432/dbname
PGSSL=                       # `require` khi đi qua proxy công khai
SESSION_SECRET=
ADMIN_USER=admin
ADMIN_PASSWORD=
IP_HASH_SALT=

# ── CRM đón tiếp · phiên + OTP ────────────────────────────────────────────────
CRM_SESSION_SECRET=
CRM_SESSION_TTL_H=12         # ngày lễ đặt 48, xong lễ trả về 12
OTP_SALT=
OTP_DELIVERY=console         # `smtp` trên LIVE; `console` in mã ra log (lab)
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── CỬA CHECK-IN (E08-D041) ───────────────────────────────────────────────────
# Hai công tắc này nói về CỬA, không nói về ảnh sự kiện.
CRM_DOOR_OPEN=               # 1 = trang cửa không đòi đăng nhập
CRM_DOOR_SIGNUP=             # 1 = PG tự tạo tài khoản `staff` bằng OTP.
                             # Cố ý CHỈ có tác dụng khi cửa ĐÓNG (`CRM_DOOR_OPEN` khác 1).
CRM_PHONE_UNLOCK=            # mật khẩu mở khoá xem SĐT khách

# ── ẢNH SỰ KIỆN · nhân viên tự đăng ký (E08-D128) ─────────────────────────────
# ĐỘC LẬP với `CRM_DOOR_OPEN`: bật cái này thì email công ty chưa có trong
# `staff_users` vẫn nhận được OTP để vào `/crm/anh-su-kien`, kể cả khi cửa đang mở.
# Tài khoản tự sinh LUÔN là `staff` (chỉ xem ảnh khách đã duyệt) — không bao giờ
# là `btl`. Miền email được khoá CỨNG trong mã (@esuhai.com, @esuworks.vn), không
# đọc từ biến môi trường.
# Bỏ biến đi = quay lại hành vi trước D128.
CRM_ANH_SIGNUP=

# ── Kho ảnh (MinIO / S3) ──────────────────────────────────────────────────────
MINIO_ENDPOINT=127.0.0.1
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=
MINIO_SECRET_KEY=
MINIO_BUCKET=esuhai-crm
MINIO_PRESIGN_TTL=300

# ── Khác ──────────────────────────────────────────────────────────────────────
CRM_UI=classic               # `new` = shell crm-app-v2.html
CRM_SMOKE_BEARER=            # ≥32 ký tự; bỏ trống = tắt hẳn làn smoke
GOOGLE_OAUTH_CLIENT_ID=
GOOGLE_PICKER_API_KEY=
GOOGLE_CLOUD_PROJECT_NUMBER=
